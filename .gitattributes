# One checkout, one byte stream. The validation chain pins content hashes (patch
# files, contract files), so a line ending that depends on the platform would
# make the same commit pass on one OS and fail on another. `eol=lf` gives every
# checkout the bytes the baselines were recorded from.
* text=auto eol=lf

# Binary assets never take part in text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.onnx binary
*.zip binary

# Hash-pinned artifacts: the pinned hash is over these exact bytes, so git must
# never rewrite them for a platform (and drift by an editor is then visible).
profiles/web/patches/*.patch -text

# 批处理文件必须 CRLF：cmd.exe 对 LF-only 的 .cmd 会错解析（实测每行吃掉开头 1-2 个字符）。
# 仓库内按 text 归一化为 LF，检出时转 CRLF——与全局 eol=lf 约定并存。
*.cmd text eol=crlf
*.bat text eol=crlf

# ── 质量体系（2026-09-17 追加，不改动上面的既有规则）──────────────────────────────
# 平台专属脚本的行尾必须与平台约定一致，否则是真实故障而不是风格问题：
#   .sh  → LF（CRLF 会让 POSIX sh 在 `#!` 与 `set -u` 行上因 \r 报错）
#   .ps1/.cmd/.bat → CRLF（PS 5.1 与 cmd.exe 对 LF-only 的解析见 AGENTS.md 第 6 节；
#                        另外 .ps1 还必须是 UTF-8 with BOM，这一点 gitattributes 表达不了，
#                        由 scripts/checks/format.mjs 作为门禁强制）
*.sh text eol=lf
*.ps1 text eol=crlf
*.mjs text eol=lf
