{
  "schemaVersion": 1,
  "matrixId": "dsh-0.1.1-rc.2",
  "dshVersion": "0.1.1-rc.2",
  "officialRuntimeSha256": "13a5fe0ee8cddda2306d302eb0dbfdd601e96d14baeb512867b4b6d1d72f6679",
  "dom": {
    "rootSlot": "body > #root > [data-slot=\"root\"]",
    "rootSurface": "[data-slot=\"root\"]",
    "sidebar": "[data-slot=\"sidebar\"]",
    "sidebarResizeHandle": "[data-side=\"sidebar\"]",
    "conversation": "[data-slot=\"conversation\"]",
    "shellOverlay": "[data-slot=\"shell.overlay\"]",
    "settingsDialog": "[data-slot=\"sidebar.settings\"] [role=\"dialog\"]",
    "phaseHero": "[data-phase=\"hero\"]",
    "phaseActive": "[data-phase=\"active\"]",
    "phaseAny": "[data-phase]",
    "composerSeat": "[data-composer-seat]",
    "composerCard": "[data-composer-card=\"true\"]",
    "composerTextarea": "textarea",
    "conversationScroll": "[data-conversation-scroll]",
    "inputScroll": "[data-input-scroll]",
    "chatFlow": "[data-chat-flow]",
    "sessionTree": "[role=\"tree\"][aria-label=\"会话\"],[role=\"tree\"][aria-label=\"Sessions\"]",
    "sessionItem": "[role=\"treeitem\"]",
    "expandedSessionItem": "[role=\"treeitem\"][aria-expanded=\"true\"]",
    "selectedSessionItem": "[role=\"treeitem\"][aria-selected=\"true\"]",
    "sidebarBrandMark": "[data-slot=\"sidebar.brand.mark\"]",
    "openSidebar": "body > #root > [data-slot=\"root\"] button[aria-label=\"打开侧边栏\"],body > #root > [data-slot=\"root\"] button[aria-label=\"Open sidebar\"]",
    "collapseSidebar": "body > #root > [data-slot=\"root\"] button[aria-label=\"收起侧边栏\"],body > #root > [data-slot=\"root\"] button[aria-label=\"Collapse sidebar\"]",
    "newSession": "button[aria-label=\"新建会话\"],button[aria-label=\"New session\"],button[aria-label=\"New Session\"]",
    "sessionHeader": "[data-slot=\"conversation.session.header\"]",
    "sessionHeaderActions": "[data-slot=\"conversation.session.header.actions\"]",
    "sessionHeaderUtilities": "[data-slot=\"conversation.session.header.utilities\"]",
    "send": "button[aria-label=\"发送消息\"],button[aria-label=\"停止生成\"],button[aria-label=\"停止\"],button[aria-label=\"Send message\"],button[aria-label=\"Stop generating\"],button[aria-label=\"Stop\"]",
    "sendOnly": "button[aria-label=\"发送消息\"],button[aria-label=\"Send message\"]",
    "context": "button[aria-label^=\"上下文\"],button[aria-label^=\"Context\"]",
    "voice": "[data-dsh-fairy-voice-control],[aria-label=\"Fairy 朗读控制\"],input[aria-label=\"朗读音量\"]",
    "command": "button[aria-label=\"命令\"],button[aria-label=\"Commands\"],button[aria-label=\"Command\"]",
    "access": "button[aria-label^=\"访问模式\"],button[aria-label^=\"Access mode\"]",
    "model": "select[aria-label^=\"选择模型\"],select[aria-label^=\"Select model\"],button[aria-label^=\"选择模型\"],button[aria-label^=\"Select model\"]",
    "reasoning": "button[aria-label^=\"模型 \"][aria-haspopup=\"menu\"],button[aria-label^=\"Model \"][aria-haspopup=\"menu\"]",
    "workspace": "button[aria-label=\"选择工作区\"],button[aria-label=\"Choose workspace\"]",
    "balance": "[data-slot=\"sidebar.footer.action\"] *[aria-label^=\"DeepSeek 余额\"],[data-slot=\"sidebar.footer.action\"] *[aria-label^=\"DeepSeek balance\"]",
    "undo": "button[aria-label=\"撤销当前版本效果\"],button[aria-label=\"Undo current version effect\"]",
    "redo": "button[aria-label=\"重施加下一版本效果\"],button[aria-label=\"Redo next version effect\"]",
    "toBottom": "button[aria-label=\"回到底部\"],button[aria-label=\"Back to bottom\"]"
  },
  "attributes": {
    "slot": "data-slot",
    "phase": "data-phase",
    "composerSeat": "data-composer-seat",
    "composerCard": "data-composer-card",
    "conversationScroll": "data-conversation-scroll",
    "inputScroll": "data-input-scroll",
    "chatFlow": "data-chat-flow"
  },
  "slots": {
    "visual": [
      "shell.overlay",
      "conversation.session.header.utilities",
      "settings.section"
    ],
    "browserDock": [
      "shell.overlay"
    ],
    "balance": [
      "sidebar.footer.action"
    ],
    "voice": [
      "conversation.input.left",
      "conversation.chat.assistant-actions",
      "settings.section"
    ],
    "memory": [
      "settings.section"
    ],
    "messageEdit": [
      "conversation.view",
      "conversation.session.header.actions"
    ],
    "reasoning": [
      "conversation.input.model",
      "settings.general.item"
    ]
  },
  "aria": {
    "sessionTree": [
      "会话",
      "Sessions"
    ],
    "newSession": [
      "新建会话",
      "New session"
    ],
    "workspace": [
      "选择工作区",
      "Choose workspace"
    ],
    "send": [
      "发送消息",
      "停止",
      "停止生成",
      "Send message",
      "Stop generating",
      "Stop"
    ],
    "sidebarOpen": [
      "打开侧边栏",
      "Open sidebar"
    ],
    "sidebarCollapse": [
      "收起侧边栏",
      "Collapse sidebar"
    ]
  },
  "session": {
    "clientService": "sessions",
    "currentSnapshot": "sessions.list.getSnapshot().current",
    "binding": "sessions.binding(id)",
    "startupClear": "sessions.clear()"
  },
  "conversationProjection": {
    "sessionStore": {
      "interface": "ChatNodeStore",
      "implementation": "MutableChatNodeStore",
      "lookup": "get(key)",
      "iteration": "values()"
    },
    "nodeKinds": {
      "user": "user",
      "assistant": "assistant-step"
    },
    "visualActivity": {
      "projection": "deriveSessionActivity",
      "authority": "session.running+committed-user-message",
      "states": [
        "normal",
        "thinking",
        "comforting"
      ],
      "precedence": [
        "comforting",
        "thinking",
        "normal"
      ]
    }
  },
  "workspace": {
    "clientService": "workspaces",
    "baselineSnapshot": "workspaces.list.getSnapshot()",
    "baselineReady": "baselinesReady",
    "recentWorkspace": "recentWorkspaceId",
    "startSession": "workspaces.startSession()",
    "subscribe": "workspaces.list.subscribe"
  },
  "svg": {
    "requiredTokens": [
      "namespaceCloneReferences",
      "url(#",
      "href",
      "filter",
      "clip-path",
      "mask",
      "marker",
      "aria-hidden",
      "inert"
    ]
  },
  "browserAutomation": {
    "transport": "stdio proxy to the pinned @playwright/mcp executable",
    "mode": "headless Chrome with a dedicated persistent profile",
    "dockState": "same-origin /browser-dock/state and /browser-dock/frame",
    "captureAfter": [
      "navigate",
      "click",
      "type",
      "form",
      "keyboard",
      "dialog",
      "tabs",
      "resize",
      "wait"
    ],
    "cleanup": [
      "browser close",
      "session switch",
      "plugin unload",
      "proxy exit"
    ],
    "externalTakeover": "revision-bound, one-shot, only after login or CAPTCHA detection"
  },
  "officialDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "browserEvidence": {
    "requiredCases": [
      "normal-light-new-session",
      "normal-dark-new-session",
      "hdd-light-new-session",
      "hdd-dark-new-session",
      "normal-light-historical-session",
      "hdd-light-historical-session",
      "hdd-composer-replacement",
      "hdd-normal-mode-transition",
      "safari-hdd-transition-svg-integrity",
      "rapid-sidebar-collapse-reopen",
      "console-errors-and-warnings"
    ],
    "evidenceDirectory": "fairy-system/browser-evidence",
    "upgradeRule": "Do not approve a new DSH runtime until every required case has a dated evidence record or an explicit reviewed exception."
  }
}
